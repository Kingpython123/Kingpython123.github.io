---
import { SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
---

<!-- TODO: 这一页是占位内容，等你把真实信息填进去 -->
<Base title={`关于 · ${SITE_TITLE}`} description="关于我和这个站点">
	<h1 class="text-[1.75rem]">关于</h1>
	<div class="prose mt-8" data-pagefind-body>
		<p>
			我在做机器学习与系统方向的学习和实践。这个站点用来存放笔记。
		</p>

		<h2>这个站点</h2>
		<p>
			静态站，用 Astro 生成，托管在 GitHub Pages 上，源码在
			<a href="https://github.com/Kingpython123/Kingpython123.github.io">这个仓库</a>。
		</p>

		<h2>联系</h2>
		<p>
			GitHub <a href="https://github.com/Kingpython123">@Kingpython123</a>
		</p>
	</div>
</Base>
