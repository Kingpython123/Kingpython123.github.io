---
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getPublishedNotes } from '../lib/posts';

const recent = (await getPublishedNotes()).slice(0, 5);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- TODO: 换成你自己的自我介绍 -->
	<h1 class="text-[1.75rem]">{SITE_TITLE}</h1>
	<div class="prose mt-6">
		<p>
			这里记录我在机器学习与系统方向的学习笔记，主要是课程推导、论文阅读和实现过程中的踩坑记录。
			写下来是为了迫使自己把"大概懂了"变成"能讲清楚"。
		</p>
		<p>
			目前在跟 Stanford CS336（Language Modeling from Scratch），代码放在
			<a href="https://github.com/Kingpython123/CS336-assignment">CS336-assignment</a>，
			讲解性的文字在这边。
		</p>
	</div>

	<section class="mt-14">
		<h2 class="text-base font-semibold">近期笔记</h2>

		{
			recent.length === 0 ? (
				<p class="mt-4 text-muted">还没有已发布的笔记。</p>
			) : (
				<>
					<ul class="mt-4">
						{recent.map((note) => (
							<li class="flex flex-wrap items-baseline justify-between gap-x-6 border-b border-rule py-3">
								<a href={`/notes/${note.id}/`} class="no-underline hover:underline">
									{note.data.title}
									{note.data.draft && <span class="ml-2 text-sm text-muted">[草稿]</span>}
								</a>
								<span class="text-sm text-muted tabular-nums">
									<FormattedDate date={note.data.date} />
								</span>
							</li>
						))}
					</ul>
					<p class="mt-4 text-sm">
						<a href="/notes">全部笔记 →</a>
					</p>
				</>
			)
		}
	</section>
</Base>
