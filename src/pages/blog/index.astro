---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 按年分组，像论文列表那样呈现，篇数变多后仍然扫得过来
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
	const year = post.data.pubDate.getUTCFullYear();
	const group = byYear.get(year);
	if (group) {
		group.push(post);
	} else {
		byYear.set(year, [post]);
	}
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`笔记 · ${SITE_TITLE}`} description="全部技术学习笔记" />
	</head>
	<body>
		<Header />
		<main class="wrapper py-12">
			<h1 class="text-[1.75rem]">笔记</h1>
			<p class="mt-3 text-sm text-muted">共 {posts.length} 篇</p>

			{
				years.map((year) => (
					<section class="mt-12">
						<h2 class="text-sm font-semibold tracking-widest text-muted tabular-nums">{year}</h2>
						<ul class="mt-3">
							{byYear.get(year)!.map((post) => (
								<li class="border-b border-rule py-3">
									<div class="flex flex-wrap items-baseline justify-between gap-x-6">
										<a href={`/blog/${post.id}/`} class="no-underline hover:underline">
											{post.data.title}
										</a>
										<span class="text-sm text-muted tabular-nums">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</div>
									{post.data.description && (
										<p class="mt-1 text-sm text-muted">{post.data.description}</p>
									)}
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
