---
import NoteList from '../../../components/NoteList.astro';
import { SITE_TITLE } from '../../../consts';
import Base from '../../../layouts/Base.astro';
import { getNotesBySection, type Note } from '../../../lib/posts';
import type { Section } from '../../../lib/sections';

// 章节索引页。
// 这条路由只匹配单段路径，和 [...slug].astro 的产出路径不重叠：
// 章节 id 和顶层笔记 slug 是两个互不相交的集合。
export async function getStaticPaths() {
	const { sections } = await getNotesBySection();
	return sections.map(({ section, notes }) => ({
		params: { section: section.id },
		props: { section, notes },
	}));
}

interface Props {
	section: Section;
	notes: Note[];
}

const { section, notes } = Astro.props;
---

<Base title={`${section.name} · ${SITE_TITLE}`} description={section.description}>
	<nav class="text-sm text-muted">
		<a href="/notes">笔记</a>
	</nav>

	<h1 class="mt-2 text-[1.75rem]">{section.name}</h1>
	{section.description && <p class="mt-3 text-muted">{section.description}</p>}
	<p class="mt-3 text-sm text-muted">共 {notes.length} 篇</p>

	<div class="mt-8">
		<NoteList notes={notes} />
	</div>
</Base>
