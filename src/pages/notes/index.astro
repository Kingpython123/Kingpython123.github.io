---
import NoteList from '../../components/NoteList.astro';
import { SITE_TITLE } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getNotesBySection, getPublishedNotes } from '../../lib/posts';

const all = await getPublishedNotes();
const { sections, loose } = await getNotesBySection();
---

<Base title={`笔记 · ${SITE_TITLE}`} description="全部技术学习笔记">
	<h1 class="text-[1.75rem]">笔记</h1>
	<p class="mt-3 text-sm text-muted">
		共 {all.length} 篇，分为 {sections.length} 个专题
	</p>

	{all.length === 0 && <p class="mt-10 text-muted">还没有已发布的笔记。</p>}

	{
		sections.map(({ section, notes }) => (
			<section class="mt-12">
				<h2 class="text-base font-semibold">
					<a href={`/notes/${section.id}/`} class="no-underline hover:underline">
						{section.name}
					</a>
					<span class="ml-2 text-sm font-normal text-muted tabular-nums">{notes.length}</span>
				</h2>
				{section.description && <p class="mt-1 text-sm text-muted">{section.description}</p>}
				<div class="mt-3">
					<NoteList notes={notes} />
				</div>
			</section>
		))
	}

	{
		loose.length > 0 && (
			<section class="mt-12">
				<h2 class="text-base font-semibold">
					其他
					<span class="ml-2 text-sm font-normal text-muted tabular-nums">{loose.length}</span>
				</h2>
				<div class="mt-3">
					<NoteList notes={loose} />
				</div>
			</section>
		)
	}
</Base>
